{
  "name": "cghq-work-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @cghq/api dev",
    "dev:web": "pnpm --filter @cghq/web dev",
    "build": "pnpm --filter @cghq/contracts build && pnpm --filter @cghq/api build && pnpm --filter @cghq/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "devDependencies": {
    "mysql2": "^3.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
