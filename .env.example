# MySQL (Aiven SSL connection string)
DATABASE_URL=mysql://avnadmin:password@your-aiven-host:12345/defaultdb?ssl-mode=REQUIRED

# Auth & Sessions
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
PUBLIC_ORIGIN=http://localhost:5173

# Team Defaults
TEAM_TIMEZONE_DEFAULT=Asia/Dhaka

# Vercel Blob (exports)
BLOB_READ_WRITE_TOKEN=

# Vercel Cron
CRON_SECRET=change-me-in-production

# Logging
LOG_LEVEL=info
